# Serv00 生产环境配置示例
# 复制此文件为 .env 并修改配置

# 运行环境
ENV=production
DEBUG=false

# 数据库配置（Serv00 使用 SQLite）
DATABASE_URL=sqlite:///~/opspilot_data/app.db

# JWT密钥（请修改为随机强密码）
SECRET_KEY=your-random-secret-key-here-change-in-production

# CORS 跨域配置（替换为您的实际域名）
CORS_ORIGINS=https://your-frontend-domain.serv00.com

# 服务器配置
HOST=0.0.0.0
PORT=8000
