# 后端生产环境配置 - Serv00
# 请复制此文件为 .env 并修改配置

# ============================================
# 应用信息
# ============================================
# ⚠️ 注意: 版本号由构建脚本自动生成，请勿手动修改
# 格式: v主版本.次版本.修订-YYYYMMDD-构建序号
# 示例: v1.0.0-20250407-001
APP_VERSION=v1.0.0-20260410-001
BUILD_TIME=2026-04-10 16:26:03

# ============================================
# 运行环境
# ============================================
ENV=production
DEBUG=false

# ============================================
# 数据库配置（Serv00 使用 SQLite）
# 注意：部署后需要手动修改为实际路径，例如：
# DATABASE_URL=sqlite:///home/chenruiting2024/opspilot_data/app.db
# ============================================
DATABASE_URL=sqlite:///~/opspilot_data/app.db

# ============================================
# 安全密钥（请修改为随机强密码，建议 32 位以上）
# ============================================
SECRET_KEY=your-random-secret-key-change-this-in-production

# ============================================
# CORS 跨域配置（同域部署时可选）
# 同域部署：前后端共享同一域名，无需特殊 CORS 配置
#   - 可注释掉此行，或设为同一域名
#   - 例如：CORS_ORIGINS=https://your-domain.serv00.net
# 跨域部署：需要添加前端域名，如 https://frontend-domain.serv00.net
# ============================================
# CORS_ORIGINS=https://your-domain.serv00.net

# ============================================
# 服务器配置
# ============================================
HOST=0.0.0.0
PORT=60361

# ============================================
# 文件上传配置
# 注意：部署后需要手动修改为实际路径
# ============================================
UPLOAD_DIR=~/opspilot_uploads
MAX_UPLOAD_SIZE=52428800
