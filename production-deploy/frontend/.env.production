# 生产环境配置 - Serv00
# 构建时会自动使用此配置
#
# ⚠️ 注意: 以下版本号仅为模板默认值
# 实际版本号由构建脚本 (scripts/build-frontend.sh 或 scripts/package-all.sh) 自动生成
# 生成格式: v主版本.次版本.修订-YYYYMMDD-构建序号
# 示例: v1.0.0-20250407-001
# 生成的版本号会写入 dist/config.js 中的 window.APP_CONFIG.VERSION

# API 基础地址（部署后修改为实际后端地址）
VITE_API_BASE_URL=https://opspilot.chenruiting2024.serv00.net/api/v1

# 应用名称
VITE_APP_NAME=OpsPilot

# 版本号（模板默认值，构建时会被覆盖）
VITE_APP_VERSION=1.0.0-dev
